{
	"name": "hono-open-api-starter",
	"type": "module",
	"version": "1.0.0",
	"license": "MIT",
	"scripts": {
		"dev": "wrangler dev",
		"dev:remote": "wrangler dev --remote --ip 0.0.0.0",
		"predeploy": "tsx src/scripts/check-deploy-config.ts",
		"deploy": "wrangler deploy --minify",
		"start": "node ./dist/src/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "cross-env DB_MIGRATING=true tsx src/db/migrate.ts",
		"create-admin": "tsx src/scripts/create-admin.ts",
		"generate-jwt-keys": "tsx src/scripts/generate-jwt-keys.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "cross-env NODE_ENV=test vitest",
		"build": "tsc && tsc-alias",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1129.0",
		"@aws-sdk/s3-request-presigner": "^3.1129.0",
		"@hono/node-server": "^2.1.1",
		"@hono/zod-openapi": "^1.6.3",
		"@neondatabase/serverless": "^1.1.0",
		"@scalar/hono-api-reference": "^0.12.1",
		"dotenv": "^17.4.2",
		"dotenv-expand": "^13.0.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.7",
		"hono-pino": "^0.10.3",
		"path-to-regexp": "^8.4.2",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"zod": "^4.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@cloudflare/workers-types": "^5.20260910.1",
		"@types/node": "^26.5.1",
		"@types/pg": "^8.23.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"tsc-alias": "^1.9.4",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.130.0"
	}
}
