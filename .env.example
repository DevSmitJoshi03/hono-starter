# .env — only for the Node entrypoint (`bun run build && bun run start`) and
# for drizzle-kit (`bun run db:generate`, `bun run db:migrate`).
# The Workers runtime (`wrangler dev` / deploy) does NOT read this file — see
# .dev.vars.example and the "Deployment" section of README.md.
#
# Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

# Required for drizzle-kit and the Node server.
DATABASE_URL=postgres://user:pass@localhost:5432/app

# Ed25519 PEM keys, single line with literal \n.
#   bun run src/scripts/generate-jwt-keys.ts
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=900

REFRESH_TOKEN_TTL_MS=604800000
AUTH_MODE=SINGLE
OTP_EXPIRES_IN_MS=600000

CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=tally-cloud-backend
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

CORS_ORIGIN=http://localhost:3000

# Email branding — rebrand by changing these values, not the code.
BRAND_NAME=Your App
EMAIL_FROM_ADDRESS=noreply@example.com
SITE_URL=https://example.com
LOGO_URL=
BRAND_ACCENT_COLOR=#2563eb
